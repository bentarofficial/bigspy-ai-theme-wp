{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bigspy/hscroll-panel",
	"title": "Horizontal panel",
	"category": "bigspy",
	"icon": "arrow-right-alt",
	"description": "One panel of a Horizontal Scroll section. Holds any blocks, with its own background color.",
	"textdomain": "bigspy-ai-theme-wp",
	"parent": [
		"bigspy/horizontal-scroll"
	],
	"attributes": {
		"background": {
			"type": "string",
			"default": ""
		},
		"textColor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "bst-motion-editor",
	"editorStyle": "bst-motion-editor",
	"render": "file:./render.php"
}
