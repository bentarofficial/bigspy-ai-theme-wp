{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/tabs",
	"title": "Tabs",
	"category": "bigspy",
	"icon": "index-card",
	"description": "Tabbed content: a heading on the left, tab titles on the right and any blocks in each tab. Tabs can wrap or scroll with an arrow, turn into an accordion on phones and open from a #link. Great for product or post groups.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"style": {
			"type": "string",
			"default": "underline"
		},
		"align": {
			"type": "string",
			"default": "left"
		},
		"event": {
			"type": "string",
			"default": "click"
		},
		"stretch": {
			"type": "boolean",
			"default": false
		},
		"navSize": {
			"type": "number",
			"default": 0
		},
		"activeColor": {
			"type": "string",
			"default": ""
		},
		"activeText": {
			"type": "string",
			"default": ""
		},
		"fade": {
			"type": "boolean",
			"default": true
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"headingTag": {
			"type": "string",
			"default": "h2"
		},
		"headingSize": {
			"type": "number",
			"default": 0
		},
		"headingColor": {
			"type": "string",
			"default": ""
		},
		"overflow": {
			"type": "string",
			"default": "wrap"
		},
		"arrows": {
			"type": "string",
			"default": "toggle"
		},
		"arrowStyle": {
			"type": "string",
			"default": "chevron"
		},
		"radius": {
			"type": "number",
			"default": -1
		},
		"gap": {
			"type": "number",
			"default": -1
		},
		"mobile": {
			"type": "string",
			"default": "tabs"
		},
		"defaultTab": {
			"type": "number",
			"default": 1
		},
		"hashLink": {
			"type": "boolean",
			"default": false
		},
		"linkText": {
			"type": "string",
			"default": ""
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"html": false
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
