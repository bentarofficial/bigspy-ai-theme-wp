{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/tabs",
	"title": "Tabs",
	"category": "bigspy",
	"icon": "index-card",
	"description": "Tabbed content.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"style": {
			"type": "string",
			"default": "underline"
		},
		"align": {
			"type": "string",
			"default": "left"
		},
		"event": {
			"type": "string",
			"default": "click"
		},
		"stretch": {
			"type": "boolean",
			"default": false
		},
		"navSize": {
			"type": "number",
			"default": 0
		},
		"activeColor": {
			"type": "string",
			"default": ""
		},
		"activeText": {
			"type": "string",
			"default": ""
		},
		"fade": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"anchor": true,
		"html": false
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
