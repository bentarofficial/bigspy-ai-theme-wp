{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/divider",
	"title": "Divider",
	"category": "bigspy",
	"icon": "minus",
	"description": "Horizontal line: solid, dashed, dotted, double, fade, wave, zigzag, round dots, thick-thin or shadow; width in % or px per device, spacing per device, gradient colors, text/icon left-center-right with typography, icon size and round background, draw-in animation.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"style": {
			"type": "string",
			"default": "solid"
		},
		"width": {
			"type": "number",
			"default": 100
		},
		"thickness": {
			"type": "number",
			"default": 1
		},
		"color": {
			"type": "string",
			"default": ""
		},
		"align": {
			"type": "string",
			"default": "center"
		},
		"spacing": {
			"type": "number",
			"default": 24
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"icon": {
			"type": "string",
			"default": ""
		},
		"contentColor": {
			"type": "string",
			"default": ""
		},
		"gradient": {
			"type": "boolean",
			"default": false
		},
		"widthUnit": {
			"type": "string",
			"default": ""
		},
		"widthTablet": {
			"type": "number"
		},
		"widthMobile": {
			"type": "number"
		},
		"spacingTablet": {
			"type": "number"
		},
		"spacingMobile": {
			"type": "number"
		},
		"gradientFrom": {
			"type": "string",
			"default": ""
		},
		"gradientTo": {
			"type": "string",
			"default": ""
		},
		"contentPosition": {
			"type": "string",
			"default": ""
		},
		"textSize": {
			"type": "number"
		},
		"textSizeTablet": {
			"type": "number"
		},
		"textSizeMobile": {
			"type": "number"
		},
		"textWeight": {
			"type": "string",
			"default": ""
		},
		"textLetterSpacing": {
			"type": "number"
		},
		"textTransform": {
			"type": "string",
			"default": ""
		},
		"iconSize": {
			"type": "number",
			"default": 0
		},
		"iconBg": {
			"type": "string",
			"default": ""
		},
		"draw": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"anchor": true,
		"html": false
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
