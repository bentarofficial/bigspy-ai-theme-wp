{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/code",
	"title": "Code / HTML",
	"category": "bigspy",
	"icon": "editor-code",
	"description": "Custom HTML and CSS rendered on the page, or a code snippet with a copy button. Switch between Visual and Code while editing.",
	"keywords": [ "html", "css", "custom", "embed", "snippet" ],
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"code": { "type": "string", "default": "<div style=\"padding:24px;border:1px solid #e5e7eb;border-radius:12px;\"><strong>Your custom HTML</strong><p>Edit visually or switch to Code.</p></div>" },
		"mode": { "type": "string", "default": "html" },
		"css": { "type": "string", "default": "" },
		"language": { "type": "string", "default": "HTML" },
		"theme": { "type": "string", "default": "dark" },
		"wrap": { "type": "boolean", "default": false },
		"showCopy": { "type": "boolean", "default": true },
		"maxHeight": { "type": "number", "default": 0 }
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
