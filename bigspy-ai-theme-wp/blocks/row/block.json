{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/row",
	"title": "Row",
	"category": "bigspy",
	"icon": "columns",
	"description": "A 12-column responsive grid. Add Column blocks and set their widths per device, with gap, vertical alignment and reverse order on mobile. The base of every layout.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"gap": {
			"type": "string",
			"default": "medium"
		},
		"verticalAlign": {
			"type": "string",
			"default": "stretch"
		},
		"justify": {
			"type": "string",
			"default": "start"
		},
		"reverseMobile": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		}
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
