{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/slider",
	"title": "Slider",
	"category": "bigspy",
	"icon": "slides",
	"description": "Every block inside becomes a slide (Banners, images, groups…).",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"slidesDesktop": {
			"type": "number",
			"default": 1
		},
		"slidesTablet": {
			"type": "number",
			"default": 1
		},
		"slidesMobile": {
			"type": "number",
			"default": 1
		},
		"gap": {
			"type": "number",
			"default": 0
		},
		"autoplay": {
			"type": "number",
			"default": 5
		},
		"arrows": {
			"type": "boolean",
			"default": true
		},
		"arrowsMobile": {
			"type": "boolean",
			"default": true
		},
		"dots": {
			"type": "boolean",
			"default": true
		},
		"loop": {
			"type": "boolean",
			"default": true
		},
		"arrowStyle": {
			"type": "string",
			"default": "circle"
		},
		"effect": {
			"type": "string",
			"default": "slide"
		},
		"peek": {
			"type": "number",
			"default": 0
		},
		"arrowPosition": {
			"type": "string",
			"default": "inside"
		},
		"arrowColor": {
			"type": "string",
			"default": "light"
		},
		"arrowSize": {
			"type": "string",
			"default": "md"
		},
		"arrowsAlways": {
			"type": "boolean",
			"default": false
		},
		"dotStyle": {
			"type": "string",
			"default": "pill"
		},
		"dotsInside": {
			"type": "boolean",
			"default": false
		},
		"progress": {
			"type": "boolean",
			"default": false
		},
		"timer": {
			"type": "string",
			"default": ""
		},
		"pauseHover": {
			"type": "boolean",
			"default": true
		},
		"slideHeightD": { "type": "number", "default": 0 },
		"slideHeightT": { "type": "number", "default": 0 },
		"slideHeightM": { "type": "number", "default": 0 },
		"minHeight": {
			"type": "number",
			"default": 0
		},
		"slideRadius": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
