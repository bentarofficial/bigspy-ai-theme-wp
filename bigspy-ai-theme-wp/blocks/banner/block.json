{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/banner",
	"title": "Banner",
	"category": "bigspy",
	"icon": "cover-image",
	"description": "Image banner with overlay color or gradient, text placed anywhere (nine positions), height per device and an optional link on the whole banner. Add headings, text and buttons inside. Use it for hero sections and promotions.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"imageMobileId": {
			"type": "number",
			"default": 0
		},
		"imageMobileUrl": {
			"type": "string",
			"default": ""
		},
		"focalX": {
			"type": "number",
			"default": 50
		},
		"focalY": {
			"type": "number",
			"default": 50
		},
		"heightMode": { "type": "string", "default": "px" },
		"heightVhD": { "type": "number", "default": 100 },
		"heightVhT": { "type": "number", "default": 80 },
		"heightVhM": { "type": "number", "default": 70 },
		"imgRatio": { "type": "number", "default": 0 },
		"heightDesktop": {
			"type": "number",
			"default": 500
		},
		"heightTablet": {
			"type": "number",
			"default": 420
		},
		"heightMobile": {
			"type": "number",
			"default": 340
		},
		"overlayColor": {
			"type": "string",
			"default": "#000000"
		},
		"overlayOpacity": {
			"type": "number",
			"default": 35
		},
		"posX": {
			"type": "string",
			"default": "center"
		},
		"posY": {
			"type": "string",
			"default": "middle"
		},
		"contentWidth": {
			"type": "number",
			"default": 70
		},
		"textAlign": {
			"type": "string",
			"default": "center"
		},
		"textScheme": {
			"type": "string",
			"default": "light"
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"linkNewTab": {
			"type": "boolean",
			"default": false
		},
		"hover": {
			"type": "string",
			"default": "zoom"
		},
		"radius": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true
		}
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
