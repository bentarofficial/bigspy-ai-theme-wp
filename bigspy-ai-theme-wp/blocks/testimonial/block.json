{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/testimonial",
	"title": "Testimonial",
	"category": "bigspy",
	"icon": "format-quote",
	"description": "Customer review with photo, name and rating.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"role": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"rating": {
			"type": "number",
			"default": 5
		},
		"style": {
			"type": "string",
			"default": "card"
		},
		"align": {
			"type": "string",
			"default": "left"
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"background": true,
			"text": true
		}
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
