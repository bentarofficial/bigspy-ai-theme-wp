{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/nav-menu",
	"title": "Navigation menu",
	"category": "bigspy",
	"icon": "menu",
	"description": "Show any WordPress menu anywhere on a page: horizontal, vertical or with a mobile toggle. Useful for footers, sidebars and landing pages.",
	"keywords": [
		"menu",
		"navigation",
		"nav",
		"điều hướng"
	],
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"menuId": {
			"type": "number",
			"default": 0
		},
		"layout": {
			"type": "string",
			"default": "horizontal"
		},
		"align": {
			"type": "string",
			"default": "left"
		},
		"style": {
			"type": "string",
			"default": "plain"
		},
		"mobile": {
			"type": "string",
			"default": "toggle"
		},
		"subOpen": { "type": "string", "default": "" },
		"depth": { "type": "number", "default": 0 },
		"itemPad": { "type": "number", "default": -1 },
		"gapMobile": { "type": "number", "default": 0 },
		"activeColor": { "type": "string", "default": "" },
		"activeBg": { "type": "string", "default": "" },
		"weight": { "type": "string", "default": "" },
		"textCase": { "type": "string", "default": "" },
		"gap": {
			"type": "number",
			"default": 24
		},
		"size": {
			"type": "number",
			"default": 0
		},
		"color": {
			"type": "string",
			"default": ""
		},
		"hover": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "bst-blocks-more",
	"render": "file:./render.php"
}
