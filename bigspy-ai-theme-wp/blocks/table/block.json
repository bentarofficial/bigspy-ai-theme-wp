{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/table",
	"title": "Table",
	"category": "bigspy",
	"icon": "editor-table",
	"description": "A responsive data table: one row per line with cells separated by |. Add a header row, stripes and borders. Scrolls sideways on small screens.",
	"keywords": [
		"table",
		"bảng",
		"compare",
		"data"
	],
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"data": {
			"type": "string",
			"default": "Tính năng | Gói A | Gói B\nTên miền | Có | Có\nHosting | 1 năm | 1 năm\nBài viết SEO | 20 | 30"
		},
		"header": {
			"type": "boolean",
			"default": true
		},
		"firstColumn": {
			"type": "boolean",
			"default": false
		},
		"striped": {
			"type": "boolean",
			"default": true
		},
		"bordered": {
			"type": "boolean",
			"default": true
		},
		"align": {
			"type": "string",
			"default": "left"
		},
		"accent": {
			"type": "string",
			"default": ""
		},
		"caption": {
			"type": "string",
			"default": ""
		},
		"tableStyle": { "type": "string", "default": "" },
		"headBg": { "type": "string", "default": "" },
		"headColor": { "type": "string", "default": "" },
		"stickyHead": { "type": "boolean", "default": false },
		"stickyCol": { "type": "boolean", "default": false },
		"mobile": { "type": "string", "default": "scroll" },
		"highlightCol": { "type": "number", "default": 0 },
		"marks": { "type": "boolean", "default": false },
		"hoverRow": { "type": "boolean", "default": false },
		"cellPad": { "type": "number", "default": 0 },
		"radius": { "type": "number", "default": -1 },
		"colAlign": { "type": "string", "default": "" },
		"colWidth": { "type": "string", "default": "" },
		"sortable": { "type": "boolean", "default": false },
		"search": { "type": "boolean", "default": false },
		"size": {
			"type": "number",
			"default": 15
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "bst-blocks-more",
	"render": "file:./render.php"
}
