{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bigspy/listing-grid",
	"title": "Listing grid",
	"category": "bigspy-list",
	"icon": "grid-view",
	"description": "Grid of directory listings with logo, category, rating, price and short text; filter by category or Featured. Needs BIGSPY AI List mode.",
	"keywords": [
		"listings",
		"directory",
		"grid",
		"bigspy ai list"
	],
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"layout": {
			"type": "string",
			"default": "square"
		},
		"columnsDesktop": {
			"type": "number",
			"default": 5
		},
		"columnsTablet": {
			"type": "number",
			"default": 3
		},
		"columnsMobile": {
			"type": "number",
			"default": 2
		},
		"limit": {
			"type": "number",
			"default": 10
		},
		"featuredOnly": {
			"type": "boolean",
			"default": false
		},
		"showDescription": {
			"type": "boolean",
			"default": true
		},
		"showCategory": {
			"type": "boolean",
			"default": true
		},
		"showPricing": {
			"type": "boolean",
			"default": true
		},
		"showTags": {
			"type": "boolean",
			"default": false
		},
		"showCTA": {
			"type": "boolean",
			"default": false
		},
		"categoryId": {
			"type": "number",
			"default": 0
		},
		"showLogo": {
			"type": "boolean",
			"default": true
		},
		"showRating": {
			"type": "boolean",
			"default": true
		},
		"showFeatured": {
			"type": "string",
			"default": "default"
		},
		"showWatermark": {
			"type": "string",
			"default": "default"
		},
		"titleLines": {
			"type": "number",
			"default": 1
		},
		"descriptionLines": {
			"type": "number",
			"default": 2
		}
	},
	"supports": {
		"anchor": true,
		"html": false
	},
	"editorScript": "bst-blocks-listing",
	"render": "file:./render.php"
}
