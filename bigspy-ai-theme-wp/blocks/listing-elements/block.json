{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bigspy/elements",
	"title": "Listing elements",
	"category": "bigspy-list",
	"icon": "screenoptions",
	"description": "Ready sections for a directory: Featured, Latest, Popular or Related listings, categories or blog posts, with a title and an optional Sponsored slot. Needs BIGSPY AI List mode.",
	"keywords": [
		"featured",
		"latest",
		"popular",
		"related",
		"sidebar",
		"bigspy ai list"
	],
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"elementType": {
			"type": "string",
			"default": "featured"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"count": {
			"type": "number",
			"default": 12
		},
		"startPosition": {
			"type": "number",
			"default": 1
		},
		"layout": {
			"type": "string",
			"default": "square"
		},
		"columnsDesktop": {
			"type": "number",
			"default": 4
		},
		"columnsTablet": {
			"type": "number",
			"default": 2
		},
		"columnsMobile": {
			"type": "number",
			"default": 1
		},
		"categoryId": {
			"type": "number",
			"default": 0
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"order": {
			"type": "string",
			"default": "DESC"
		},
		"showDescription": {
			"type": "boolean",
			"default": true
		},
		"showCategory": {
			"type": "boolean",
			"default": true
		},
		"showPricing": {
			"type": "boolean",
			"default": true
		},
		"showSponsored": {
			"type": "boolean",
			"default": true
		},
		"showLogo": {
			"type": "boolean",
			"default": true
		},
		"showRating": {
			"type": "boolean",
			"default": true
		},
		"showTags": {
			"type": "boolean",
			"default": false
		},
		"showCTA": {
			"type": "boolean",
			"default": false
		},
		"showFeatured": {
			"type": "string",
			"default": "default"
		},
		"showWatermark": {
			"type": "string",
			"default": "default"
		},
		"titleLines": {
			"type": "number",
			"default": 1
		},
		"descriptionLines": {
			"type": "number",
			"default": 2
		},
		"sponsoredPosition": {
			"type": "string",
			"default": "between"
		},
		"sponsoredEvery": {
			"type": "number",
			"default": 3
		},
		"displayLocation": {
			"type": "string",
			"default": "normal"
		},
		"displayMode": {
			"type": "string",
			"default": "grid"
		},
		"ctaPosition": {
			"type": "string",
			"default": "bottom"
		},
		"ctaAlignment": {
			"type": "string",
			"default": "right"
		},
		"seeMoreAlignment": {
			"type": "string",
			"default": "right"
		},
		"showViewMore": {
			"type": "boolean",
			"default": true
		},
		"viewMoreText": {
			"type": "string",
			"default": "View more →"
		},
		"viewMoreDestination": {
			"type": "string",
			"default": "automatic"
		},
		"blogShowImage": {
			"type": "boolean",
			"default": true
		},
		"blogShowDate": {
			"type": "boolean",
			"default": true
		},
		"blogShowExcerpt": {
			"type": "boolean",
			"default": false
		},
		"categoryCount": {
			"type": "number",
			"default": 24
		},
		"categoryShowCount": {
			"type": "boolean",
			"default": true
		},
		"categoryShowImage": {
			"type": "boolean",
			"default": true
		},
		"categoryShowDescription": {
			"type": "boolean",
			"default": false
		},
		"categoryColumnsDesktop": {
			"type": "number",
			"default": 5
		},
		"categoryColumnsTablet": {
			"type": "number",
			"default": 3
		},
		"categoryColumnsMobile": {
			"type": "number",
			"default": 2
		},
		"gap": {
			"type": "number",
			"default": 16
		},
		"categoryBorderEnabled": {
			"type": "boolean",
			"default": true
		},
		"categoryBorderWidth": {
			"type": "number",
			"default": 1
		},
		"categoryBorderColor": {
			"type": "string",
			"default": ""
		},
		"categoryBorderRadius": {
			"type": "number",
			"default": 14
		},
		"categoryHoverEnabled": {
			"type": "boolean",
			"default": true
		},
		"categoryHoverBorderWidth": {
			"type": "number",
			"default": 1
		},
		"categoryHoverBorderColor": {
			"type": "string",
			"default": ""
		},
		"categoryHoverLift": {
			"type": "number",
			"default": 2
		},
		"categoryHoverImageZoom": {
			"type": "number",
			"default": 1.02
		},
		"categoryHoverShadow": {
			"type": "string",
			"default": "soft"
		},
		"categoryHoverTransition": {
			"type": "number",
			"default": 200
		},
		"blogLayout": {
			"type": "string",
			"default": "cards"
		},
		"blogCategoryId": {
			"type": "number",
			"default": 0
		},
		"blogShowNumber": {
			"type": "boolean",
			"default": true
		},
		"blogShowAuthor": {
			"type": "boolean",
			"default": false
		},
		"blogShowCategory": {
			"type": "boolean",
			"default": false
		},
		"blogExcerptWords": {
			"type": "number",
			"default": 24
		},
		"blogShowViewMore": {
			"type": "boolean",
			"default": true
		},
		"blogViewMoreText": {
			"type": "string",
			"default": "Read more articles →"
		},
		"viewMoreBehavior": {
			"type": "string",
			"default": "redirect"
		},
		"relatedContextId": {
			"type": "number",
			"default": 0
		},
		"categoryShowViewMore": {
			"type": "boolean",
			"default": true
		},
		"categoryViewMoreText": {
			"type": "string",
			"default": "View all categories →"
		},
		"viewMoreUrl": {
			"type": "string",
			"default": ""
		},
		"sponsoredButtonStyle": {
			"type": "string",
			"default": "default"
		},
		"sponsoredButtonText": {
			"type": "string",
			"default": ""
		},
		"sponsoredShowLabel": {
			"type": "boolean",
			"default": true
		},
		"sponsoredOpenNewTab": {
			"type": "string",
			"default": "default"
		},
		"buttonAlign": {
			"type": "string",
			"default": ""
		},
		"buttonBg": {
			"type": "string",
			"default": ""
		},
		"buttonColor": {
			"type": "string",
			"default": ""
		},
		"buttonBorderColor": {
			"type": "string",
			"default": ""
		},
		"buttonHoverBg": {
			"type": "string",
			"default": ""
		},
		"buttonHoverColor": {
			"type": "string",
			"default": ""
		},
		"buttonBorderWidth": {
			"type": "string",
			"default": ""
		},
		"buttonRadius": {
			"type": "string",
			"default": ""
		},
		"buttonFontSize": {
			"type": "string",
			"default": ""
		},
		"buttonFontWeight": {
			"type": "string",
			"default": ""
		},
		"buttonHeight": {
			"type": "string",
			"default": ""
		},
		"buttonPaddingX": {
			"type": "string",
			"default": ""
		},
		"cardBg": {
			"type": "string",
			"default": ""
		},
		"cardBorderColor": {
			"type": "string",
			"default": ""
		},
		"cardBorderWidth": {
			"type": "string",
			"default": ""
		},
		"cardRadius": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"html": false
	},
	"editorScript": "bst-blocks-listing",
	"render": "file:./render.php"
}
