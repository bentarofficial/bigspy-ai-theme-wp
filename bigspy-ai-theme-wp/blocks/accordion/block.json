{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/accordion",
	"title": "Accordion / FAQ",
	"category": "bigspy",
	"icon": "list-view",
	"description": "Collapsible questions and answers for FAQs, policies and specifications. Open one or several items at a time, choose the icon and style, and optionally add FAQPage schema for Google.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"style": {
			"type": "string",
			"default": "bordered"
		},
		"single": {
			"type": "boolean",
			"default": true
		},
		"faqSchema": {
			"type": "boolean",
			"default": false
		},
		"iconStyle": {
			"type": "string",
			"default": "chevron"
		},
		"iconPosition": {
			"type": "string",
			"default": "right"
		},
		"numbered": {
			"type": "boolean",
			"default": false
		},
		"titleTag": {
			"type": "string",
			"default": "div"
		},
		"titleSize": {
			"type": "number",
			"default": 0
		},
		"titleColor": {
			"type": "string",
			"default": ""
		},
		"titleBg": {
			"type": "string",
			"default": ""
		},
		"activeColor": {
			"type": "string",
			"default": ""
		},
		"activeBg": {
			"type": "string",
			"default": ""
		},
		"contentBg": {
			"type": "string",
			"default": ""
		},
		"radius": {
			"type": "number",
			"default": -1
		},
		"gap": {
			"type": "number",
			"default": -1
		},
		"smooth": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"anchor": true,
		"html": false
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php",
	"providesContext": {
		"bst/accordionTitleTag": "titleTag"
	}
}
