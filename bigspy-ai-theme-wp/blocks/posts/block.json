{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/posts",
	"title": "Blog Posts",
	"category": "bigspy",
	"icon": "grid-view",
	"description": "Latest or selected blog posts as a grid, list or slider. Filter by category or tag, choose columns per device, and show or hide image, date, excerpt and read-more link.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"count": {
			"type": "number",
			"default": 6
		},
		"category": {
			"type": "number",
			"default": 0
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"offset": {
			"type": "number",
			"default": 0
		},
		"layout": {
			"type": "string",
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"columnsTablet": {
			"type": "number",
			"default": 2
		},
		"columnsMobile": {
			"type": "number",
			"default": 1
		},
		"cardStyle": {
			"type": "string",
			"default": ""
		},
		"imageRatio": {
			"type": "string",
			"default": "16-9"
		},
		"showMeta": {
			"type": "boolean",
			"default": true
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		},
		"readMore": {
			"type": "string",
			"default": "Read more"
		},
		"autoplay": {
			"type": "number",
			"default": 0
		},
		"tag": {
			"type": "number",
			"default": 0
		},
		"ids": {
			"type": "string",
			"default": ""
		},
		"excludeCurrent": {
			"type": "boolean",
			"default": true
		},
		"titleSize": {
			"type": "number",
			"default": 0
		},
		"titleLines": {
			"type": "number",
			"default": 0
		},
		"excerptLength": {
			"type": "number",
			"default": 0
		},
		"showDate": {
			"type": "boolean",
			"default": true
		},
		"showCategory": {
			"type": "boolean",
			"default": true
		},
		"showAuthor": {
			"type": "boolean",
			"default": false
		},
		"showReadTime": {
			"type": "boolean",
			"default": false
		},
		"dateBadge": {
			"type": "boolean",
			"default": false
		},
		"catBadge": {
			"type": "boolean",
			"default": false
		},
		"moreStyle": {
			"type": "string",
			"default": "link"
		},
		"imageHover": {
			"type": "string",
			"default": "zoom"
		},
		"align": {
			"type": "string",
			"default": "left"
		},
		"gap": {
			"type": "number",
			"default": -1
		},
		"accent": {
			"type": "string",
			"default": ""
		},
		"cardBg": {
			"type": "string",
			"default": ""
		},
		"arrows": {
			"type": "boolean",
			"default": true
		},
		"dots": {
			"type": "boolean",
			"default": true
		},
		"peek": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
