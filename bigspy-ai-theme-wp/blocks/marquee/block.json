{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/marquee",
	"title": "Scrolling text (marquee)",
	"category": "bigspy",
	"icon": "leftright",
	"description": "Text, icons, logos or cards that scroll continuously across the screen. Each item can have a link. Choose rows, direction, item style, edge fade, tilt, scroll effects and per-device sizes.",
	"keywords": [
		"marquee",
		"ticker",
		"scrolling",
		"chữ chạy"
	],
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"items": {
			"type": "string",
			"default": "Thiết kế website\nSEO\nQuảng cáo Google Ads\nNội dung số"
		},
		"speed": {
			"type": "number",
			"default": 30
		},
		"direction": {
			"type": "string",
			"default": "left"
		},
		"pauseHover": {
			"type": "boolean",
			"default": true
		},
		"separator": {
			"type": "string",
			"default": "star"
		},
		"size": {
			"type": "number",
			"default": 28
		},
		"weight": {
			"type": "string",
			"default": "700"
		},
		"color": {
			"type": "string",
			"default": ""
		},
		"bgColor": {
			"type": "string",
			"default": ""
		},
		"gap": {
			"type": "number",
			"default": 40
		},
		"outline": {
			"type": "boolean",
			"default": false
		},
		"paddingY": {
			"type": "number",
			"default": 18
		},
		"previewItems": {
			"type": "array",
			"default": []
		},
		"itemStyle": {
			"type": "string",
			"default": ""
		},
		"itemBg": {
			"type": "string",
			"default": ""
		},
		"itemBorderColor": {
			"type": "string",
			"default": ""
		},
		"itemRadius": {
			"type": "number"
		},
		"imgHeight": {
			"type": "number"
		},
		"rows": {
			"type": "number",
			"default": 1
		},
		"rowDirection": {
			"type": "string",
			"default": ""
		},
		"rowSpeedShift": {
			"type": "number",
			"default": 0
		},
		"rowGap": {
			"type": "number"
		},
		"orientation": {
			"type": "string",
			"default": ""
		},
		"height": {
			"type": "number",
			"default": 420
		},
		"fade": {
			"type": "number",
			"default": 0
		},
		"tilt": {
			"type": "number",
			"default": 0
		},
		"cross": {
			"type": "boolean",
			"default": false
		},
		"crossBg": {
			"type": "string",
			"default": ""
		},
		"crossColor": {
			"type": "string",
			"default": ""
		},
		"scrollBoost": {
			"type": "boolean",
			"default": false
		},
		"scrollReverse": {
			"type": "boolean",
			"default": false
		},
		"pauseButton": {
			"type": "boolean",
			"default": false
		},
		"loops": {
			"type": "number",
			"default": 0
		},
		"speedTablet": {
			"type": "number"
		},
		"speedMobile": {
			"type": "number"
		},
		"sizeTablet": {
			"type": "number"
		},
		"sizeMobile": {
			"type": "number"
		},
		"gapTablet": {
			"type": "number"
		},
		"gapMobile": {
			"type": "number"
		},
		"paddingYTablet": {
			"type": "number"
		},
		"paddingYMobile": {
			"type": "number"
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "bst-blocks-more",
	"render": "file:./render.php"
}
