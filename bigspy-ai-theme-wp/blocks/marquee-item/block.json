{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/marquee-item",
	"title": "Marquee item",
	"category": "bigspy",
	"icon": "minus",
	"description": "One item of a Scrolling text (marquee) strip: text with an optional icon or logo image, a link and its own color.",
	"textdomain": "bigspy-ai-theme-wp",
	"parent": [
		"bst/marquee"
	],
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"icon": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"url": {
			"type": "string",
			"default": ""
		},
		"newTab": {
			"type": "boolean",
			"default": false
		},
		"rel": {
			"type": "string",
			"default": ""
		},
		"ariaLabel": {
			"type": "string",
			"default": ""
		},
		"color": {
			"type": "string",
			"default": ""
		},
		"row": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "bst-blocks-more",
	"render": "file:./render.php"
}
