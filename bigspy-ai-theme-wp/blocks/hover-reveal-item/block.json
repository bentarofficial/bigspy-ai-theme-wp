{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bigspy/hover-reveal-item",
	"title": "Hover Reveal row",
	"category": "bigspy",
	"icon": "list-view",
	"description": "One row of a Hover Reveal List: title, small text on the right, link and the image that appears on hover.",
	"textdomain": "bigspy-ai-theme-wp",
	"parent": [
		"bigspy/hover-reveal"
	],
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"meta": {
			"type": "string",
			"default": ""
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "bst-motion-editor",
	"editorStyle": "bst-motion-editor",
	"render": "file:./render.php"
}
