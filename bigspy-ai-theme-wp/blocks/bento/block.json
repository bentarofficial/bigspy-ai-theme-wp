{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bigspy/bento",
	"title": "Bento Grid",
	"category": "bigspy",
	"icon": "grid-view",
	"description": "A modern grid of tiles in different sizes (small, wide, tall, large) holding any blocks. Tiles appear one after another and a soft light follows the mouse. Great for features, services or highlights. Becomes one or two columns on phones.",
	"textdomain": "bigspy-ai-theme-wp",
	"keywords": [
		"bento",
		"grid",
		"tiles",
		"features",
		"highlights",
		"lưới",
		"ô",
		"tính năng"
	],
	"attributes": {
		"gap": {
			"type": "number",
			"default": 16
		},
		"rowHeight": {
			"type": "number",
			"default": 200
		},
		"radius": {
			"type": "number",
			"default": 22
		},
		"glow": {
			"type": "boolean",
			"default": true
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "bst-motion-editor",
	"editorStyle": "bst-motion-editor",
	"render": "file:./render.php",
	"viewScript": "bst-motion-fx"
}
