{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bigspy/stack-card",
	"title": "Stack card",
	"category": "bigspy",
	"icon": "images-alt",
	"description": "One card of Stacking Cards: any blocks inside, with its own background and text color.",
	"textdomain": "bigspy-ai-theme-wp",
	"parent": [
		"bigspy/stack-cards"
	],
	"attributes": {
		"background": {
			"type": "string",
			"default": ""
		},
		"textColor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "bst-motion-editor",
	"editorStyle": "bst-motion-editor",
	"render": "file:./render.php"
}
