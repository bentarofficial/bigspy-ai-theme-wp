{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/title",
	"title": "Section Title",
	"category": "bigspy",
	"icon": "heading",
	"description": "Section heading (H1–H6, P or DIV) with a decorative line, small subtitle above, an optional link on the title and an optional link on the right whose text you choose (\"View all\", \"See more\"…).",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"subtitle": {
			"type": "string",
			"default": ""
		},
		"tag": {
			"type": "string",
			"default": "h2"
		},
		"style": {
			"type": "string",
			"default": "bottom-line"
		},
		"align": {
			"type": "string",
			"default": "center"
		},
		"size": {
			"type": "number",
			"default": 0
		},
		"color": {
			"type": "string",
			"default": ""
		},
		"lineColor": {
			"type": "string",
			"default": ""
		},
		"linkText": {
			"type": "string",
			"default": ""
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"titleUrl": {
			"type": "string",
			"default": ""
		},
		"newTab": {
			"type": "boolean",
			"default": false
		},
		"nofollow": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		}
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
