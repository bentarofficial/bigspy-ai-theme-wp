{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/widget-area",
	"title": "Widget area (sidebar)",
	"category": "bigspy",
	"icon": "welcome-widgets-menus",
	"description": "Show any sidebar or widget area inside a page, such as the shop filters or the blog sidebar, so you can place widgets anywhere in a layout.",
	"keywords": [
		"sidebar",
		"widget",
		"widgets"
	],
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"area": {
			"type": "string",
			"default": "sidebar-blog"
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "bst-blocks-extra",
	"render": "file:./render.php"
}