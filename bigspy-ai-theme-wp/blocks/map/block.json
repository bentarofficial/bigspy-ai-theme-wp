{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/map",
	"title": "Google Map",
	"category": "bigspy",
	"icon": "location-alt",
	"description": "Embed a Google Map from an address – no API key needed.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"address": {
			"type": "string",
			"default": ""
		},
		"zoom": {
			"type": "number",
			"default": 15
		},
		"height": {
			"type": "number",
			"default": 400
		},
		"radius": {
			"type": "number",
			"default": 8
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
