{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/heading",
	"title": "Heading",
	"category": "bigspy",
	"icon": "heading",
	"description": "Heading from H1 to H6 with size per device, weight, color, line height, maximum width, alignment and optional link. Use one H1 per page for SEO.",
	"keywords": [
		"title",
		"h1",
		"h2",
		"h3"
	],
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"tag": {
			"type": "string",
			"default": "h2"
		},
		"align": {
			"type": "string",
			"default": ""
		},
		"size": {
			"type": "number",
			"default": 0
		},
		"sizeTablet": {
			"type": "number",
			"default": 0
		},
		"sizeMobile": {
			"type": "number",
			"default": 0
		},
		"lineHeight": {
			"type": "number",
			"default": 0
		},
		"maxWidth": {
			"type": "number",
			"default": 0
		},
		"balance": {
			"type": "boolean",
			"default": false
		},
		"weight": {
			"type": "string",
			"default": ""
		},
		"color": {
			"type": "string",
			"default": ""
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"gradient": {
			"type": "boolean",
			"default": false
		},
		"gradientFrom": {
			"type": "string",
			"default": ""
		},
		"gradientTo": {
			"type": "string",
			"default": ""
		},
		"gradientAngle": {
			"type": "number",
			"default": 90
		},
		"highlight": {
			"type": "string",
			"default": ""
		},
		"highlightColor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		}
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
