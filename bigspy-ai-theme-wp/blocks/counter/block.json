{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/counter",
	"title": "Counter",
	"category": "bigspy",
	"icon": "performance",
	"description": "Animated number that counts up when scrolled into view: years of experience, customers, projects, rating. Enter only the final number; choose the start value and counting style. Show the label under the number or inside one sentence, e.g. \"Over 3,000 happy customers\", with separate sizes and colors.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"number": {
			"type": "string",
			"default": "1000"
		},
		"prefix": {
			"type": "string",
			"default": ""
		},
		"suffix": {
			"type": "string",
			"default": "+"
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"separator": {
			"type": "string",
			"default": "."
		},
		"duration": {
			"type": "number",
			"default": 1600
		},
		"size": {
			"type": "number",
			"default": 44
		},
		"color": {
			"type": "string",
			"default": ""
		},
		"align": {
			"type": "string",
			"default": "center"
		},
		"layout": {
			"type": "string",
			"default": "stack"
		},
		"from": {
			"type": "number",
			"default": 0
		},
		"ease": {
			"type": "string",
			"default": "out"
		},
		"textSize": {
			"type": "number",
			"default": 0
		},
		"textColor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"html": false
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
