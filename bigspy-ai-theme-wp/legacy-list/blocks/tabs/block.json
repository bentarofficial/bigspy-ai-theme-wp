{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bigspy/tabs",
	"title": "BIGSPY Tabs",
	"category": "bigspy-list",
	"icon": "index-card",
	"description": "Legacy BIGSPY AI List block, kept so old content still renders. Not insertable.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"style": {
			"type": "string",
			"default": "outline"
		},
		"orientation": {
			"type": "string",
			"default": "horizontal"
		},
		"navCase": {
			"type": "string",
			"default": "normal"
		},
		"size": {
			"type": "string",
			"default": "medium"
		},
		"align": {
			"type": "string",
			"default": "left"
		},
		"activation": {
			"type": "string",
			"default": "click"
		},
		"activeTab": {
			"type": "number",
			"default": 0
		},
		"navGap": {
			"type": "number",
			"default": 8
		},
		"panelPadding": {
			"type": "number",
			"default": 24
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"inserter": false,
		"reusable": false
	},
	"editorScript": "bst-legacy-list-editor",
	"viewScript": "file:./view.js",
	"style": "bst-legacy-list",
	"render": "file:./render.php"
}
