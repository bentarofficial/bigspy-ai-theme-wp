{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bigspy/divider",
	"title": "BIGSPY Divider",
	"category": "bigspy-list",
	"icon": "minus",
	"description": "Legacy BIGSPY AI List block, kept so old content still renders. Not insertable.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"style": {
			"type": "string",
			"default": "solid"
		},
		"color": {
			"type": "string",
			"default": "#dbe7f0"
		},
		"thickness": {
			"type": "number",
			"default": 1
		},
		"width": {
			"type": "number",
			"default": 100
		},
		"align": {
			"type": "string",
			"default": "center"
		},
		"spacing": {
			"type": "number",
			"default": 24
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"inserter": false,
		"reusable": false
	},
	"editorScript": "bst-legacy-list-editor",
	"style": "bst-legacy-list",
	"render": "file:./render.php"
}
