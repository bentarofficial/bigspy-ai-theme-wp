{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bigspy/button-group",
	"title": "BIGSPY Button Group",
	"category": "bigspy-list",
	"icon": "screenoptions",
	"description": "Legacy BIGSPY AI List block, kept so old content still renders. Not insertable.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"align": {
			"type": "string",
			"default": "left"
		},
		"gap": {
			"type": "number",
			"default": 12
		},
		"stackMobile": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"inserter": false,
		"reusable": false
	},
	"editorScript": "bst-legacy-list-editor",
	"style": "bst-legacy-list",
	"render": "file:./render.php"
}
