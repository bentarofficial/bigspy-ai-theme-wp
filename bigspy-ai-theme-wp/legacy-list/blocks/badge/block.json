{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bigspy/badge",
	"title": "BIGSPY Badge",
	"category": "bigspy-list",
	"icon": "tag",
	"description": "Legacy BIGSPY AI List block, kept so old content still renders. Not insertable.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"text": {
			"type": "string",
			"default": "New"
		},
		"url": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "string",
			"default": "soft"
		},
		"tone": {
			"type": "string",
			"default": "brand"
		},
		"size": {
			"type": "string",
			"default": "medium"
		},
		"align": {
			"type": "string",
			"default": "left"
		},
		"icon": {
			"type": "string",
			"default": "none"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": {
			"margin": true
		},
		"inserter": false,
		"reusable": false
	},
	"editorScript": "bst-legacy-list-editor",
	"style": "bst-legacy-list",
	"render": "file:./render.php"
}
