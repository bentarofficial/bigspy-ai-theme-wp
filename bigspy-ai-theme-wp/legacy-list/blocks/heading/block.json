{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bigspy/heading",
	"title": "BIGSPY Heading",
	"category": "bigspy-list",
	"icon": "heading",
	"description": "Legacy BIGSPY AI List block, kept so old content still renders. Not insertable.",
	"textdomain": "bigspy-ai-theme-wp",
	"attributes": {
		"text": {
			"type": "string",
			"default": "Your heading"
		},
		"level": {
			"type": "number",
			"default": 2
		},
		"align": {
			"type": "string",
			"default": "left"
		},
		"preset": {
			"type": "string",
			"default": "default"
		},
		"maxWidth": {
			"type": "number",
			"default": 0
		},
		"fontSizeDesktop": {
			"type": "number",
			"default": 0
		},
		"fontSizeTablet": {
			"type": "number",
			"default": 0
		},
		"fontSizeMobile": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontWeight": true
		},
		"inserter": false,
		"reusable": false
	},
	"editorScript": "bst-legacy-list-editor",
	"style": "bst-legacy-list",
	"render": "file:./render.php"
}
