# Count-up numbers (1.76).
msgctxt "block description"
msgid "Animated number that counts up when scrolled into view: years of experience, customers, projects, rating. Enter only the final number; choose the start value and counting style. Show the label under the number or inside one sentence, e.g. \"Over 3,000 happy customers\", with separate sizes and colors."
msgstr "Con số chạy tăng dần khi cuộn tới: số năm kinh nghiệm, khách hàng, dự án, điểm đánh giá. Chỉ cần nhập số cuối; chọn số bắt đầu và kiểu chạy. Nhãn đặt dưới con số hoặc nằm trong cùng một câu, ví dụ \"Hơn 3.000 khách hàng hài lòng\", với cỡ chữ và màu riêng."

msgid "Count-up number (select a number; it counts up from 0 on the site)"
msgstr "Số nhảy (bôi đen một con số; trên website số sẽ chạy từ 0 lên)"

msgid "Select a number first, e.g. 11.256"
msgstr "Hãy bôi đen một con số trước, ví dụ 11.256"

msgid "Count-up number"
msgstr "Số nhảy"

msgid "Label under the number"
msgstr "Nhãn dưới con số"

msgid "Inside one sentence"
msgstr "Nằm trong một câu"

msgid "Inside one sentence: prefix, number, suffix and label read as one line, e.g. \"Over 3,000 happy customers\"."
msgstr "Nằm trong một câu: phần trước số, con số, phần sau số và nhãn đọc liền một dòng, ví dụ \"Hơn 3.000 khách hàng hài lòng\"."

msgid "Start counting from"
msgstr "Bắt đầu chạy từ"

msgid "Counting style"
msgstr "Kiểu chạy số"

msgid "Fast, then slows down"
msgstr "Nhanh rồi chậm dần"

msgid "Steady"
msgstr "Đều"

msgid "Overshoot and settle"
msgstr "Vượt nhẹ rồi dừng"

msgid "Text size for prefix, suffix and label (px, 0 = automatic)"
msgstr "Cỡ chữ phần trước, phần sau và nhãn (px, 0 = tự động)"

msgid "1.76.0: Motion update: Animated Text, Scroll Story, Stacking Cards, Hover Reveal List, Line Draw, Horizontal Scroll, Zoom Hero, Video Hover Cards, Bento Grid, count-up numbers, motion intensity and style, block previews and colored icons."
msgstr "1.76.0: Bản cập nhật chuyển động: Animated Text, Scroll Story, Stacking Cards, Hover Reveal List, Line Draw, Horizontal Scroll, Zoom Hero, Video Hover Cards, Bento Grid, số nhảy đếm, cường độ và phong cách chuyển động, bản xem trước và icon màu cho khối."

msgid "Auto detect"
msgstr "Tự động phát hiện"

msgid "These checks only report. Nothing is changed or deleted unless you press an action and confirm it."
msgstr "Các mục này chỉ báo cáo. Không có gì bị sửa hoặc xoá trừ khi bạn bấm thao tác và xác nhận."

msgid "Scan now"
msgstr "Quét ngay"

msgid "Scanning…"
msgstr "Đang quét…"

msgid "Not scanned yet."
msgstr "Chưa quét lần nào."

msgid "Last scan:"
msgstr "Lần quét gần nhất:"

msgid "No problems found."
msgstr "Không phát hiện vấn đề."

msgid "Ignore this pair"
msgstr "Bỏ qua mục này"

msgid "Run automatically every week, in small background batches"
msgstr "Tự chạy mỗi tuần, chạy nền theo từng đợt nhỏ"

msgid "Needs fixing"
msgstr "Cần xử lý"

msgid "Needs review"
msgstr "Cần xem"

msgid "Delete selected"
msgstr "Xoá mục đã chọn"

msgid "Permanently delete the selected files? This cannot be undone."
msgstr "Xoá vĩnh viễn các tệp đã chọn? Không thể hoàn tác."

msgid "Replace link"
msgstr "Thay link"

msgid "New URL:"
msgstr "URL mới:"

msgid "Remove link"
msgstr "Gỡ link"

msgid "Remove this link and keep its text in every listed post?"
msgstr "Gỡ link này và giữ lại chữ trong mọi bài đã liệt kê?"

msgid "Request failed."
msgstr "Yêu cầu thất bại."

msgid "Duplicate focus keywords"
msgstr "Từ khóa chính trùng"

msgid "Compares the focus keyword of published content. Secondary keywords are not compared."
msgstr "So sánh từ khóa chính của nội dung đã xuất bản. Không so sánh từ khóa phụ."

msgid "H1 tags"
msgstr "Thẻ H1"

msgid "Opens each published page, post and product as a visitor and counts its H1 tags."
msgstr "Mở từng trang, bài viết và sản phẩm đã xuất bản như khách truy cập rồi đếm thẻ H1."

msgid "Page could not be opened"
msgstr "Không mở được trang"

msgid "No H1 tag"
msgstr "Không có thẻ H1"

msgid "%d H1 tags"
msgstr "%d thẻ H1"

msgid "Same H1 on several pages"
msgstr "H1 trùng giữa nhiều trang"

msgid "Unused media"
msgstr "Media chưa dùng"

msgid "Searches content, blocks, featured images, galleries, widgets and theme settings. Files used only by plugins or hard-coded in templates may still be listed, so check before deleting."
msgstr "Tìm trong nội dung, khối, ảnh đại diện, thư viện ảnh, widget và cài đặt theme. Tệp chỉ do plugin dùng hoặc viết cứng trong mẫu vẫn có thể bị liệt kê, nên hãy kiểm tra trước khi xoá."

msgid "%1$d files, %2$s in total."
msgstr "%1$d tệp, tổng %2$s."

msgid "Broken links"
msgstr "Link hỏng"

msgid "Checks links in published content a few at a time. Sites that block automatic checks are listed for review."
msgstr "Kiểm tra dần các link trong nội dung đã xuất bản. Trang chặn kiểm tra tự động được liệt kê để bạn xem lại."

msgid "Security scan"
msgstr "Quét bảo mật"

msgid "Compares WordPress and plugin files with official checksums and looks for PHP in uploads, suspicious code and new administrators. It only reports and does not replace a firewall."
msgstr "So tệp WordPress và plugin với checksum chính thức, tìm PHP trong uploads, mã đáng ngờ và quản trị viên mới. Chỉ báo cáo, không thay thế tường lửa."

msgid "WordPress checksums unavailable"
msgstr "Không lấy được checksum WordPress"

msgid "WordPress file missing"
msgstr "Thiếu tệp WordPress"

msgid "WordPress file changed"
msgstr "Tệp WordPress bị thay đổi"

msgid "Plugin file changed"
msgstr "Tệp plugin bị thay đổi"

msgid "PHP file in uploads"
msgstr "Tệp PHP trong uploads"

msgid "Suspicious code"
msgstr "Mã đáng ngờ"

msgid "New administrator"
msgstr "Quản trị viên mới"

msgid "Features"
msgstr "Tính năng"

msgid "WebP on upload"
msgstr "WebP khi tải ảnh lên"

msgid "Convert new JPEG and PNG uploads to WebP. Existing images are not changed."
msgstr "Chuyển ảnh JPEG và PNG mới tải lên sang WebP. Ảnh đã có không thay đổi."

msgid "SMTP email"
msgstr "Gửi email qua SMTP"

msgid "Send WordPress email through your mail server."
msgstr "Gửi email của WordPress qua máy chủ mail của bạn."

msgid "Related links in posts"
msgstr "Liên kết liên quan trong bài"

msgid "Add a short list of related posts in the middle of each post."
msgstr "Chèn danh sách ngắn các bài liên quan vào giữa mỗi bài viết."

msgid "Header and footer code"
msgstr "Mã đầu và cuối trang"

msgid "Add tracking or verification code to every front page."
msgstr "Thêm mã theo dõi hoặc mã xác minh vào mọi trang."

msgid "Saved. Leave empty to keep it."
msgstr "Đã lưu. Để trống nếu muốn giữ nguyên."

msgid "Each feature is off by default and loads no code until you turn it on. Turn one on and save to see its settings."
msgstr "Mỗi tính năng mặc định tắt và không nạp mã cho đến khi bạn bật. Bật rồi lưu để xem phần cài đặt."

msgid "WebP quality"
msgstr "Chất lượng WebP"

msgid "Files are kept as they are if WebP would not be smaller."
msgstr "Giữ nguyên tệp nếu bản WebP không nhỏ hơn."

msgid "This server cannot create WebP images, so uploads stay unchanged."
msgstr "Máy chủ này không tạo được ảnh WebP nên ảnh tải lên được giữ nguyên."

msgid "SMTP host"
msgstr "Máy chủ SMTP"

msgid "Port"
msgstr "Cổng"

msgid "Encryption"
msgstr "Mã hóa"

msgid "Username"
msgstr "Tên đăng nhập"

msgid "Password"
msgstr "Mật khẩu"

msgid "Stored encrypted. You can define BST_SMTP_PASS in wp-config.php instead."
msgstr "Được lưu ở dạng mã hóa. Bạn cũng có thể khai báo BST_SMTP_PASS trong wp-config.php."

msgid "From email"
msgstr "Email gửi đi"

msgid "From name"
msgstr "Tên người gửi"

msgid "SMTP test email"
msgstr "Email thử SMTP"

msgid "Your SMTP settings work."
msgstr "Cài đặt SMTP của bạn hoạt động tốt."

msgid "Test email sent. Check your inbox."
msgstr "Đã gửi email thử. Hãy kiểm tra hộp thư."

msgid "Test email failed:"
msgstr "Gửi email thử thất bại:"

msgid "Send a test email to me"
msgstr "Gửi email thử cho tôi"

msgid "Read also"
msgstr "Xem thêm"

msgid "Title (empty = “Read also”)"
msgstr "Tiêu đề (để trống = “Xem thêm”)"

msgid "Number of links"
msgstr "Số liên kết"

msgid "Position"
msgstr "Vị trí"

msgid "Middle of the post"
msgstr "Giữa bài"

msgid "After a paragraph"
msgstr "Sau một đoạn văn"

msgid "Paragraph number"
msgstr "Số thứ tự đoạn văn"

msgid "Skip posts with fewer paragraphs than"
msgstr "Bỏ qua bài có ít đoạn văn hơn"

msgid "Before </head>"
msgstr "Trước </head>"

msgid "After <body>"
msgstr "Sau <body>"

msgid "Before </body>"
msgstr "Trước </body>"

msgid "Only add code from a source you trust; it runs on every page."
msgstr "Chỉ thêm mã từ nguồn bạn tin cậy; mã sẽ chạy trên mọi trang."

msgid "File upload"
msgstr "Tải tệp lên"

msgid "Move CF7 forms"
msgstr "Chuyển form CF7"

msgid "Replaces a Contact Form 7 form with the built-in Form block in posts and pages. Forms in widgets or theme options are not changed. Check each form after moving it, then turn the plugin off yourself."
msgstr "Thay form Contact Form 7 bằng khối Form có sẵn trong bài viết và trang. Form trong widget hoặc tùy chọn theme không thay đổi. Hãy kiểm tra từng form sau khi chuyển, rồi tự tắt plugin."

msgid "Posts updated: %d"
msgstr "Số bài đã cập nhật: %d"

msgid "No Contact Form 7 forms found."
msgstr "Không tìm thấy form Contact Form 7 nào."

msgid "Fields"
msgstr "Trường"

msgid "Not carried over"
msgstr "Không chuyển được"

msgid "Posts to update"
msgstr "Số bài sẽ cập nhật"

msgid "Replace this form in the listed posts? WordPress keeps a revision of each post."
msgstr "Thay form này trong các bài đã liệt kê? WordPress giữ một bản lưu của mỗi bài."

msgid "Move"
msgstr "Chuyển"

msgid "1.77.0: Auto detect menu, optional Features page (WebP, SMTP, related links in posts, header and footer code), file uploads and server checks in the built-in form, Contact Form 7 migration, tighter AI Designer output."
msgstr "1.77.0: Menu Tự động phát hiện, trang Tính năng tùy chọn (WebP, SMTP, liên kết liên quan trong bài, mã đầu và cuối trang), tải tệp và kiểm tra phía máy chủ trong form có sẵn, chuyển form Contact Form 7, AI Designer tạo nội dung chặt chẽ hơn."

msgid "Support and community"
msgstr "Hỗ trợ và cộng đồng"

msgid "Facebook fanpage"
msgstr "Fanpage Facebook"

msgid "Vietnam Telegram group"
msgstr "Nhóm Telegram Việt Nam"

msgid "Global Telegram group"
msgstr "Nhóm Telegram Global"

msgid "Vietnam Facebook group"
msgstr "Group Facebook Việt Nam"

msgid "Global Facebook group"
msgstr "Group Facebook Global"

msgid "Give a star on GitHub"
msgstr "Tặng sao trên GitHub"

msgid "Resize preview"
msgstr "Đổi chiều rộng xem trước"

msgid "Drag to change the preview width. Double-click to reset."
msgstr "Kéo để đổi chiều rộng xem trước. Bấm đúp để đặt lại."

msgid "No page to preview yet"
msgstr "Chưa có trang để xem"

