msgstr "Cao – kỹ hơn"

msgid "Max – deepest work"
msgstr "Tối đa – làm sâu nhất"

msgid "New task"
msgstr "Task mới"

msgid "No API key is stored."
msgstr "Chưa lưu API key."

msgid "The API key is invalid or was revoked. Create a new key and connect again."
msgstr "API key không hợp lệ hoặc đã bị thu hồi. Hãy tạo key mới và kết nối lại."

msgid "Not enough API credit (needs about $%1$s, balance $%2$s). Top up your Kyma account."
msgstr "Không đủ số dư API (cần khoảng $%1$s, đang có $%2$s). Hãy nạp thêm vào tài khoản Kyma."

msgid "This model needs a paid Kyma account. Add credit once or choose a free model."
msgstr "Model này cần tài khoản Kyma đã nạp tiền. Hãy nạp một lần hoặc chọn model miễn phí."

msgid "Too many requests right now. Wait a moment and try again."
msgstr "Đang có quá nhiều yêu cầu. Hãy đợi một chút rồi thử lại."

msgid "The chosen model is no longer available. Pick another model in Settings."
msgstr "Model đã chọn không còn khả dụng. Hãy chọn model khác trong Cài đặt."

msgid "The model service is temporarily unavailable. Try again in a moment."
msgstr "Dịch vụ model tạm thời gián đoạn. Hãy thử lại sau ít phút."

msgid "API error (HTTP %d)."
msgstr "Lỗi API (HTTP %d)."

msgid "Business information"
msgstr "Thông tin doanh nghiệp"

msgid "Name, field, target customers, phone, address, what makes you different. The designer only uses facts written here or told in chat."
msgstr "Tên, lĩnh vực, khách hàng mục tiêu, số điện thoại, địa chỉ, điểm khác biệt. Người thiết kế chỉ dùng thông tin ghi ở đây hoặc bạn nói trong chat."

msgid "Writing standard"
msgstr "Tiêu chuẩn viết bài"

msgid "Voice, how to address readers, length, headings, words to avoid, SEO rules. Used for every page, post and product text."
msgstr "Giọng văn, cách xưng hô, độ dài, heading, từ cần tránh, quy tắc SEO. Áp dụng cho mọi nội dung trang, bài viết và sản phẩm."

msgid "Image standard"
msgstr "Tiêu chuẩn hình ảnh"

msgid "Style, main colors, ratio, people or not, text on images, what to avoid. Added to every image ImageGen creates."
msgstr "Phong cách, màu chủ đạo, tỉ lệ, có người hay không, chữ trên ảnh, điều cần tránh. Được thêm vào mọi ảnh ImageGen tạo ra."

msgid "You are not allowed to do this."
msgstr "Bạn không có quyền thực hiện việc này."

msgid "BIGSPY AI Designer – Guidelines"
msgstr "BIGSPY AI Designer – Tiêu chuẩn"

msgid "The designer follows these standards in every task. Leave a box empty and it will ask you in chat first, then offer to save your answers here."
msgstr "Người thiết kế làm theo các tiêu chuẩn này trong mọi task. Ô nào để trống, công cụ sẽ hỏi bạn trong chat trước, rồi đề nghị lưu câu trả lời vào đây."

msgid "Guidelines saved."
msgstr "Đã lưu tiêu chuẩn."

msgid "Insert suggested template"
msgstr "Chèn mẫu gợi ý"

msgid "Save guidelines"
msgstr "Lưu tiêu chuẩn"

msgid "Enter a valid API key."
msgstr "Hãy nhập API key hợp lệ."

msgid "The API key was not accepted."
msgstr "API key không được chấp nhận."

msgid "BIGSPY AI Designer – Settings"
msgstr "BIGSPY AI Designer – Cài đặt"

msgid "AI Designer tasks"
msgstr "Task AI Designer"

msgid "Task not found."
msgstr "Không tìm thấy task."

msgid "The API is not connected. Connect it in AI Designer settings."
msgstr "Chưa kết nối API. Hãy kết nối trong Cài đặt AI Designer."

msgid "Write a message first."
msgstr "Hãy viết tin nhắn trước."

msgid "Stopped."
msgstr "Đã dừng."

msgid "This task reached its budget of $%s. Raise the limit in Settings to continue."
msgstr "Task này đã chạm ngân sách $%s. Tăng giới hạn trong Cài đặt để tiếp tục."

msgid "Paused after the step limit for this effort. Reply \"continue\" to keep going, or raise the effort."
msgstr "Đã tạm dừng vì chạm giới hạn số bước của mức effort này. Trả lời \"tiếp tục\" để làm tiếp, hoặc tăng mức effort."

msgid "Answered by the fallback model %s."
msgstr "Được trả lời bởi model dự phòng %s."

msgid "Business name:\nField / services:\nTarget customers:\nPhone / Zalo:\nEmail:\nAddress:\nOpening hours:\nWhat makes us different:\nPrices or packages (if any):"
msgstr "Tên doanh nghiệp:\nLĩnh vực / dịch vụ:\nKhách hàng mục tiêu:\nĐiện thoại / Zalo:\nEmail:\nĐịa chỉ:\nGiờ mở cửa:\nĐiểm khác biệt:\nGiá hoặc gói dịch vụ (nếu có):"

msgid "Voice: friendly, clear, professional; write like a real person, no hype.\nAddress the reader as: you.\nSentences: short, one idea each; no filler or clichés.\nHeadings: one H1 per page, H2/H3 in order, each heading says what the section gives.\nSEO: main keyword in the H1, first paragraph and one H2; natural, never stuffed.\nPosts: 1,200–1,800 words, a short intro, practical steps or examples, a clear call to action.\nAvoid: unverified claims, made-up numbers, words like “best” or “number 1” without proof."
msgstr "Giọng văn: thân thiện, rõ ràng, chuyên nghiệp; viết như người thật, không phóng đại.\nXưng hô: gọi người đọc là bạn.\nCâu: ngắn, mỗi câu một ý; không lan man, không sáo rỗng.\nHeading: mỗi trang một H1, H2/H3 đúng thứ tự, mỗi heading nói rõ phần đó mang lại gì.\nSEO: từ khoá chính có trong H1, đoạn đầu và một H2; tự nhiên, không nhồi nhét.\nBài viết: 1.200–1.800 chữ, mở bài ngắn, có bước làm hoặc ví dụ thực tế, kêu gọi hành động rõ ràng.\nTránh: khẳng định chưa kiểm chứng, số liệu bịa, các từ như “tốt nhất”, “số 1” khi không có bằng chứng."

msgid "Style: clean, modern, realistic photo look, soft natural light.\nColors: follow the website colors.\nPeople: Asian people when people appear; natural expressions.\nText on images: none, unless asked.\nRatio: 16:9 for banners, 4:3 for cards, 1:1 for products.\nAvoid: real celebrities, other brands' logos, watermarks, distorted hands or faces."
msgstr "Phong cách: sạch sẽ, hiện đại, giống ảnh chụp thật, ánh sáng tự nhiên dịu.\nMàu sắc: theo màu của website.\nCon người: người châu Á khi có người; biểu cảm tự nhiên.\nChữ trên ảnh: không có, trừ khi được yêu cầu.\nTỉ lệ: 16:9 cho banner, 4:3 cho thẻ, 1:1 cho sản phẩm.\nTránh: người nổi tiếng có thật, logo thương hiệu khác, watermark, tay hoặc mặt bị méo."
