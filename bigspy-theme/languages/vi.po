msgstr "Kết quả tìm kiếm cho “%s”"

msgid "Share:"
msgstr "Chia sẻ:"

msgid "Copy link"
msgstr "Sao chép liên kết"

msgid "Copy"
msgstr "Sao chép"

msgid "Copied!"
msgstr "Đã sao chép!"

msgid "Related posts"
msgstr "Bài viết liên quan"

msgid "Comments are closed."
msgstr "Bình luận đã đóng."

msgid "Oops! That page can not be found."
msgstr "Rất tiếc! Không tìm thấy trang này."

msgid "The page you are looking for may have been moved or deleted. Try searching instead."
msgstr "Trang bạn tìm có thể đã được chuyển hoặc xóa. Hãy thử tìm kiếm."

msgid "Back to home"
msgstr "Về trang chủ"

msgid "Nothing matched your search. Please try different keywords."
msgstr "Không có kết quả phù hợp. Vui lòng thử từ khóa khác."

msgid "There is nothing here yet."
msgstr "Chưa có nội dung."

msgid "Load more"
msgstr "Xem thêm"

msgid "Read more"
msgstr "Đọc tiếp"

msgid "Contact us"
msgstr "Liên hệ"

msgid "Ready to start your project?"
msgstr "Bạn đã sẵn sàng bắt đầu?"

msgid "Get a free consultation and a quote within 24 hours."
msgstr "Nhận tư vấn miễn phí và báo giá trong vòng 24 giờ."

msgid "Copyright © [year] [site_title]. All rights reserved."
msgstr "Bản quyền © [year] [site_title]. Bảo lưu mọi quyền."

msgid "Contact for price"
msgstr "Liên hệ để biết giá"

msgid "Loading…"
msgstr "Đang tải…"

msgid "Sold out"
msgstr "Hết hàng"

msgid "Sale"
msgstr "Giảm giá"

