{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/icon-box",
	"title": "Icon Box",
	"category": "bigspy",
	"icon": "star-filled",
	"description": "Icon or image with title and text (features, services, benefits).",
	"textdomain": "bigspy-theme",
	"attributes": {
		"icon": {
			"type": "string",
			"default": "check"
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"iconStyle": {
			"type": "string",
			"default": "circle"
		},
		"iconSize": {
			"type": "number",
			"default": 32
		},
		"iconColor": {
			"type": "string",
			"default": ""
		},
		"iconBg": {
			"type": "string",
			"default": ""
		},
		"position": {
			"type": "string",
			"default": "top"
		},
		"align": {
			"type": "string",
			"default": "center"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"titleTag": {
			"type": "string",
			"default": "h3"
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"boxStyle": {
			"type": "string",
			"default": "none"
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true
		}
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
