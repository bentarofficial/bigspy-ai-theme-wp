{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/posts",
	"title": "Blog Posts",
	"category": "bigspy",
	"icon": "grid-view",
	"description": "Latest posts as grid, list or slider.",
	"textdomain": "bigspy-theme",
	"attributes": {
		"count": {
			"type": "number",
			"default": 6
		},
		"category": {
			"type": "number",
			"default": 0
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"offset": {
			"type": "number",
			"default": 0
		},
		"layout": {
			"type": "string",
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"columnsTablet": {
			"type": "number",
			"default": 2
		},
		"columnsMobile": {
			"type": "number",
			"default": 1
		},
		"cardStyle": {
			"type": "string",
			"default": ""
		},
		"imageRatio": {
			"type": "string",
			"default": "16-9"
		},
		"showMeta": {
			"type": "boolean",
			"default": true
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		},
		"readMore": {
			"type": "string",
			"default": "Read more"
		},
		"autoplay": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
