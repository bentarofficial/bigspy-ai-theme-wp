{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/accordion",
	"title": "Accordion / FAQ",
	"category": "bigspy",
	"icon": "list-view",
	"description": "Collapsible items, great for FAQs.",
	"textdomain": "bigspy-theme",
	"attributes": {
		"style": {
			"type": "string",
			"default": "bordered"
		},
		"single": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"anchor": true,
		"html": false
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
