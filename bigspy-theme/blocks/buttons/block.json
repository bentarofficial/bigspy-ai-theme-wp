{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/buttons",
	"title": "Buttons",
	"category": "bigspy",
	"icon": "button",
	"description": "A row of buttons with alignment and spacing.",
	"textdomain": "bigspy-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "left"
		},
		"gap": {
			"type": "number",
			"default": 12
		},
		"stackMobile": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		}
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
