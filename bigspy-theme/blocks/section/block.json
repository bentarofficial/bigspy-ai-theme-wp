{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/section",
	"title": "Section",
	"category": "bigspy",
	"icon": "align-full-width",
	"description": "Full-width section with background image, overlay, responsive padding and inner container.",
	"textdomain": "bigspy-theme",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"bgImage": {
			"type": "string",
			"default": ""
		},
		"bgImageId": {
			"type": "number",
			"default": 0
		},
		"bgSize": {
			"type": "string",
			"default": "cover"
		},
		"bgPosition": {
			"type": "string",
			"default": "center center"
		},
		"bgFixed": {
			"type": "boolean",
			"default": false
		},
		"overlayColor": {
			"type": "string",
			"default": ""
		},
		"overlayOpacity": {
			"type": "number",
			"default": 50
		},
		"textScheme": {
			"type": "string",
			"default": ""
		},
		"contentWidth": {
			"type": "string",
			"default": "boxed"
		},
		"paddingDesktop": {
			"type": "number",
			"default": 80
		},
		"paddingTablet": {
			"type": "number",
			"default": 60
		},
		"paddingMobile": {
			"type": "number",
			"default": 40
		},
		"minHeight": {
			"type": "number",
			"default": 0
		},
		"minHeightUnit": {
			"type": "string",
			"default": "px"
		},
		"verticalAlign": {
			"type": "string",
			"default": "center"
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		}
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
