{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bst/slider",
	"title": "Slider",
	"category": "bigspy",
	"icon": "slides",
	"description": "Every block inside becomes a slide (Banners, images, groups…).",
	"textdomain": "bigspy-theme",
	"attributes": {
		"slidesDesktop": {
			"type": "number",
			"default": 1
		},
		"slidesTablet": {
			"type": "number",
			"default": 1
		},
		"slidesMobile": {
			"type": "number",
			"default": 1
		},
		"gap": {
			"type": "number",
			"default": 0
		},
		"autoplay": {
			"type": "number",
			"default": 5
		},
		"arrows": {
			"type": "boolean",
			"default": true
		},
		"dots": {
			"type": "boolean",
			"default": true
		},
		"loop": {
			"type": "boolean",
			"default": true
		},
		"arrowStyle": {
			"type": "string",
			"default": "circle"
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "bst-blocks-editor",
	"render": "file:./render.php"
}
